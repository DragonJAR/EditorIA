# Whitelist: solo editoria/ (nombre kebab-case exacto de la skill) y los README de repositorio van a git.
# Todo lo demás (VIDEOS/, temporales, etc.) se ignora.
/*
!/.gitignore
!/LICENSE
!/editoria/
!/README.md
!/README.en.md

# Registros y logs locales nunca se publican al remoto
RSI_LOG*
RSI_LOG.md
RSI_LOG_baseline.txt

# Dentro de editoria/: nunca secretos, zips ni basura generada
editoria/**/.env
editoria/**/.env.*
editoria/**/*.key
editoria/**/*.pem
editoria/**/__pycache__/
editoria/**/*.pyc
editoria/**/node_modules/
editoria/**/.DS_Store
editoria/**/*.zip
editoria/**/.ruff_cache/
editoria/**/.pytest_cache/
editoria/**/*.log
# El historial de metricas es un artefacto de RUNTIME: lo crea
# `medir_animacion.py --historial` al medir. No es contenido publicado
# (viaja a la copia instalada de todo el mundo) y cambiarlo solo
# ensucia el arbol: por eso no se versiona.
editoria/**/*.jsonl
editoria/**/*.tmp
