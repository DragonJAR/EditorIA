# Whitelist: solo SKILL/ y los dos README van al repositorio.
# Todo lo demás (VIDEOS/, temporales, etc.) se ignora.
/*
!/.gitignore
!/SKILL/
!/README.md
!/README.en.md
!/RSI_LOG.md

# Dentro de SKILL/: nunca secretos ni basura generada
SKILL/**/.env
SKILL/**/.env.*
SKILL/**/*.key
SKILL/**/*.pem
SKILL/**/__pycache__/
SKILL/**/*.pyc
SKILL/**/node_modules/
SKILL/**/.DS_Store
