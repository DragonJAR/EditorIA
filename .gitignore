# Whitelist: solo editoria/ (nombre kebab-case exacto de la skill) y los README de repositorio van a git.
# Todo lo demás (VIDEOS/, temporales, etc.) se ignora.
/*
!/.gitignore
!/LICENSE
!/editoria/
!/README.md
!/README.en.md

# Registros y logs locales nunca se publican al remoto
RSI_LOG*
RSI_LOG.md
RSI_LOG_baseline.txt

# Dentro de editoria/: nunca secretos, zips ni basura generada
editoria/**/.env
editoria/**/.env.*
editoria/**/*.key
editoria/**/*.pem
editoria/**/__pycache__/
editoria/**/*.pyc
editoria/**/node_modules/
editoria/**/.DS_Store
editoria/**/*.zip
editoria/**/.ruff_cache/
editoria/**/.pytest_cache/
editoria/**/*.log
editoria/**/*.tmp
